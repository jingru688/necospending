# Copy this to .streamlit/secrets.toml for local cloud-style testing, OR paste
# these keys into the "Secrets" box of your Streamlit Community Cloud app.
# Do NOT commit the real secrets.toml (it's gitignored).

# Use the Anthropic API for parsing (required in the cloud — no Mac there).
SPENDING_BACKEND = "api"
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: cheaper model to cut cost (~5x). Default is claude-opus-4-7.
# SPENDING_MODEL = "claude-haiku-4-5"

# Durable database so data survives restarts. Free Neon Postgres connection string.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Password both of you type to open the app. Pick anything you'll both remember.
APP_PASSWORD = "our-household-secret"
